# Local development only. Change this before inviting anyone.
APP_ENV=development
# Optional 64-hex credential encryption key. Empty creates data/credentials.key.
# API and runtime worker must share this file/key; back it up with the database.
APP_CREDENTIAL_KEY=
APP_CREDENTIAL_KEY_FILE=data/credentials.key
APP_INVITE_CODE=local-nemi-change-this-code
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://nemi:nemi_dev_only@localhost:5432/nemi?sslmode=disable
TEMPORAL_ADDRESS=127.0.0.1:7233
MODEL_PROVIDER=
# qwen or deepseek: configure an exact model you have permission to use.
MODEL_NAME=
MODEL_API_KEY=
# Prices in micro-CNY per million tokens; required for a real provider.
MODEL_INPUT_PRICE_MICRO_CNY=0
MODEL_OUTPUT_PRICE_MICRO_CNY=0

# Optional outbound group robots. Keep credentials private and never commit .env.
# Use the official webhook for a group you administer, and its exact display name.
# Feishu signature secret is required when signature verification is enabled.
CONNECTOR_FEISHU_WEBHOOK=
CONNECTOR_FEISHU_SECRET=
CONNECTOR_FEISHU_GROUP_NAME=
CONNECTOR_WECOM_WEBHOOK=
CONNECTOR_WECOM_GROUP_NAME=
# DingTalk requires signature security in this slice.
CONNECTOR_DINGTALK_WEBHOOK=
CONNECTOR_DINGTALK_SECRET=
CONNECTOR_DINGTALK_GROUP_NAME=
